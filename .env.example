# SMC-Web-Agent personal Docker deployment
# Copy this file to .env.local and replace every password/key placeholder.

SMC_BIND_ADDRESS=127.0.0.1
# dev/prod 的端口、公开 URL、数据目录、镜像 tag 由 docker/dev.env 和 docker/prod.env 提供。
# 请勿在 .env.local 中覆盖这些栈专属变量。

HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,host.docker.internal,postgres,rabbitmq,redis,minio,server,jobs-api

POSTGRES_USER=smc
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=smc
DATABASE_URL=postgresql://smc:change-this-postgres-password@postgres:5432/smc

RABBITMQ_DEFAULT_USER=smc
RABBITMQ_DEFAULT_PASS=change-this-rabbitmq-password
CELERY_BROKER_URL=amqp://smc:change-this-rabbitmq-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

MINIO_ROOT_USER=smc
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_BUCKET_NAME=smc
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_ADDRESSING_STYLE=path

# Used to encrypt the Feishu app secret stored in PostgreSQL. Generate a random value.
SMC_ENCRYPTION_KEY=change-this-application-encryption-secret

# 飞书自建应用凭据。应用需开通通讯录、多维表格、考勤、消息与群组权限，见 docs/feishu-integration.md。
FEISHU_APP_ID=cli_change-me
FEISHU_APP_SECRET=change-this-feishu-app-secret
# 考勤组名称，用于确定「应提交周报 / 应到组会」的人员集合。
FEISHU_ATTENDANCE_GROUP_NAME=SMC考勤
# 通讯录里老师所在的部门，周报「推送给老师」按它确定老师名单。
FEISHU_TEACHER_DEPARTMENT_NAME=Tenure
# 周报「先发给管理员」的目标（open_id）。可在设置页覆盖。
SMC_ADMIN_OPEN_ID=ou_1df99022ddb02b52947cd7a76f42df3b
# 组会打卡流水的时间窗（HHMM，24 小时制）。
SEMINAR_START_TIME=1900
SEMINAR_END_TIME=2030

# 定时任务触发时间（<mon..sun|day|monthly> HH:MM，按 Asia/Shanghai 时区）。
SEMINAR_PREVIEW_SCHEDULE=mon 01:26
WEEKLY_SUMMARY_SCHEDULE=mon 01:40
MONTHLY_TASK_SCHEDULE=monthly 12:00

LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_EMAIL=you@example.com
LOCAL_AUTH_NAME=Local User
LOCAL_AUTH_PASSWORD=change-this-login-password
# SESSION_COOKIE_DOMAIN 与 SECURE_COOKIES 由 docker/dev.env 和 docker/prod.env 提供。

DEBUG=false
